DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ocr_db
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/ocr_db
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=jpg,jpeg,png,bmp,tiff,webp,pdf
PADDLEOCR_LANG=en
DEBUG=true

# Auth
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed accounts (scripts/seed_admin.py) — change before running in any real env
SEED_ADMIN_NATIONAL_ID=000000000001
SEED_ADMIN_PASSWORD=change-me-admin
SEED_ADMIN_EMAIL=superadmin@local
SEED_ADMIN_FULL_NAME=Super Admin
SEED_WARD_OFFICER_NATIONAL_ID=000000000002
SEED_WARD_OFFICER_PASSWORD=change-me-ward
SEED_WARD_OFFICER_FULL_NAME=Ward Officer
SEED_WARD_NAME=Phường Mẫu
SEED_WARD_SLUG=phuong-mau

# Email (SMTP) — gửi OTP đặt lại mật khẩu cho cán bộ
# EMAIL_SENDER_BACKEND=console  # dev: log email ra stdout thay vì gửi thật
EMAIL_SENDER_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@trulem.local
SMTP_USE_TLS=true

# Branding cho email
APP_NAME=VExtract
BRAND_LOGO_URL=
BRAND_COLOR=#2563eb
SUPPORT_EMAIL=

# Password reset OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limit (slowapi) — đổi sang redis://host:port/0 khi scale nhiều worker
RATELIMIT_ENABLED=true   # đặt false ở dev để tắt limiter (không bị 429 khi test)
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_FORGOT_PASSWORD=5/hour
RATELIMIT_RESET_PASSWORD=10/hour
